import React from 'react';
import { MOODS } from '../../data/moodConstants';
import WashiTape from '../common/WashiTape';
import ScrapbookSticker from '../common/ScrapbookSticker';
import { Eye, Edit3, Trash2 } from 'lucide-react';

export default function JournalCard({
  entry,
  index = 0,
  onRead,
  onEdit,
  onDelete
}) {
  const moodConfig = MOODS.find((m) => m.id === entry.mood);

  // Slight alternation of rotation angle for tactile scrapbook feeling
  const rotations = [-1.2, 1, -0.8, 1.4, -1.5, 0.9];
  const cardRotation = rotations[index % rotations.length];

  const tapePositions = ['center', 'left', 'right'];
  const tapePosition = tapePositions[index % tapePositions.length];

  const paperClass = entry.paperStyle ? `paper-${entry.paperStyle}` : 'paper-lined';

  return (
    <article
      className={`scrapbook-card interactive ${paperClass} rotate-card-alt`}
      style={{
        padding: '1.75rem 1.5rem 1.25rem 1.5rem',
        borderRadius: 'var(--radius-md)',
        display: 'flex',
        flexDirection: 'column',
        justifyContent: 'space-between',
        minHeight: '260px',
        position: 'relative',
        transform: `rotate(${cardRotation}deg)`,
        transition: 'all 250ms ease',
        cursor: 'pointer'
      }}
      onClick={() => onRead(entry)}
    >
      {/* Decorative Washi Tape */}
      <WashiTape
        variant={entry.washiTape || 'peach'}
        position={tapePosition}
        rotation={cardRotation > 0 ? -1.5 : 2}
        width={85}
      />

      {/* Top Meta: Date & Mood Stamp */}
      <div>
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            marginBottom: '0.75rem',
            gap: '0.5rem'
          }}
        >
          <span style={{ fontSize: '0.8rem', color: 'var(--text-muted)' }}>
            📅 {entry.date}
          </span>

          <div style={{ display: 'flex', alignItems: 'center', gap: '0.4rem' }}>
            {entry.sticker && (
              <span style={{ fontSize: '1.1rem' }} title="Scrapbook sticker">
                {entry.sticker}
              </span>
            )}
            {moodConfig && (
              <span
                className="stamp-badge"
                style={{
                  backgroundColor: moodConfig.bgColor,
                  color: moodConfig.textColor,
                  border: `1px solid ${moodConfig.borderColor}`,
                  fontSize: '0.7rem'
                }}
              >
                {moodConfig.emoji} {moodConfig.label}
              </span>
            )}
          </div>
        </div>

        {/* Title */}
        <h3
          style={{
            fontSize: '1.25rem',
            marginBottom: '0.5rem',
            color: 'var(--text-brown)',
            lineHeight: '1.3'
          }}
        >
          {entry.title}
        </h3>

        {/* Content Snippet */}
        <p
          style={{
            color: 'var(--text-muted)',
            lineHeight: '1.6',
            margin: 0,
            display: '-webkit-box',
            WebkitLineClamp: 4,
            WebkitBoxOrient: 'vertical',
            overflow: 'hidden',
            fontFamily: entry.paperStyle === 'polaroid' ? 'var(--font-hand)' : 'inherit',
            fontSize: entry.paperStyle === 'polaroid' ? '1.15rem' : '0.92rem'
          }}
        >
          {entry.content}
        </p>
      </div>

      {/* Bottom Footer Actions */}
      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          marginTop: '1.25rem',
          borderTop: '1px dashed rgba(61,47,40,0.12)',
          paddingTop: '0.75rem'
        }}
        onClick={(e) => e.stopPropagation()}
      >
        <button
          onClick={() => onRead(entry)}
          className="btn btn-ghost"
          style={{
            padding: '4px 8px',
            fontSize: '0.8rem',
            gap: '0.35rem',
            color: 'var(--peach-deep)'
          }}
        >
          <Eye size={14} />
          <span>Read Page</span>
        </button>

        <div style={{ display: 'flex', gap: '0.25rem' }}>
          <button
            onClick={() => onEdit(entry)}
            className="btn-icon btn-ghost"
            style={{ width: '28px', height: '28px' }}
            title="Edit journal entry"
            aria-label="Edit journal entry"
          >
            <Edit3 size={14} />
          </button>
          <button
            onClick={() => onDelete(entry)}
            className="btn-icon btn-ghost"
            style={{ width: '28px', height: '28px', color: '#B83A3A' }}
            title="Delete entry"
            aria-label="Delete entry"
          >
            <Trash2 size={14} />
          </button>
        </div>
      </div>
    </article>
  );
}
