import React from 'react';
import { ResponsiveContainer, PieChart, Pie, Cell, Tooltip } from 'recharts';
import { MOODS } from '../../data/moodConstants';
import WashiTape from '../common/WashiTape';
import { PieChart as PieIcon } from 'lucide-react';

export default function MoodDistributionChart({ moods }) {
  if (!moods || moods.length === 0) {
    return (
      <div
        className="scrapbook-card"
        style={{ padding: '2rem', textAlign: 'center', position: 'relative' }}
      >
        <WashiTape variant="lavender" width={90} />
        <p style={{ color: 'var(--text-muted)' }}>No mood recordings available yet to chart.</p>
      </div>
    );
  }

  // Count moods
  const counts = {};
  moods.forEach((m) => {
    counts[m.mood] = (counts[m.mood] || 0) + 1;
  });

  const chartData = MOODS.map((config) => {
    const count = counts[config.id] || 0;
    return {
      name: config.label,
      moodId: config.id,
      value: count,
      color: config.color,
      emoji: config.emoji
    };
  }).filter((item) => item.value > 0);

  const totalMoods = moods.length;

  const CustomTooltip = ({ active, payload }) => {
    if (active && payload && payload.length) {
      const data = payload[0].payload;
      const percent = Math.round((data.value / totalMoods) * 100);
      return (
        <div
          style={{
            backgroundColor: 'var(--paper-white)',
            border: '1px solid var(--border-paper)',
            padding: '8px 12px',
            borderRadius: 'var(--radius-sm)',
            boxShadow: 'var(--shadow-paper)',
            fontSize: '0.85rem'
          }}
        >
          <div style={{ fontWeight: 600, color: 'var(--text-brown)' }}>
            {data.emoji} {data.name}
          </div>
          <div style={{ color: 'var(--text-muted)' }}>
            {data.value} check-in{data.value > 1 ? 's' : ''} ({percent}%)
          </div>
        </div>
      );
    }
    return null;
  };

  return (
    <div
      className="scrapbook-card"
      style={{
        padding: '2rem',
        position: 'relative'
      }}
    >
      <WashiTape variant="lavender" pattern="dots" width={95} rotation={-1.5} />

      <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '1.25rem' }}>
        <PieIcon size={18} color="var(--lavender-deep)" />
        <h3 style={{ fontSize: '1.3rem', margin: 0 }}>Mood Distribution</h3>
      </div>

      <div
        style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(260px, 1fr))',
          alignItems: 'center',
          gap: '1.5rem'
        }}
      >
        {/* Pie Chart */}
        <div style={{ width: '100%', height: '230px' }}>
          <ResponsiveContainer width="100%" height="100%">
            <PieChart>
              <Pie
                data={chartData}
                dataKey="value"
                nameKey="name"
                cx="50%"
                cy="50%"
                innerRadius={55}
                outerRadius={85}
                paddingAngle={4}
              >
                {chartData.map((entry) => (
                  <Cell key={`cell-${entry.moodId}`} fill={entry.color} stroke="#FFFDF9" strokeWidth={2} />
                ))}
              </Pie>
              <Tooltip content={<CustomTooltip />} />
            </PieChart>
          </ResponsiveContainer>
        </div>

        {/* Legend List with progress bars */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '0.65rem' }}>
          {chartData.map((item) => {
            const percent = Math.round((item.value / totalMoods) * 100);
            return (
              <div key={item.moodId}>
                <div
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'space-between',
                    fontSize: '0.85rem',
                    marginBottom: '3px'
                  }}
                >
                  <span style={{ fontWeight: 600, color: 'var(--text-brown)' }}>
                    {item.emoji} {item.name}
                  </span>
                  <span style={{ color: 'var(--text-muted)' }}>
                    {item.value} ({percent}%)
                  </span>
                </div>
                {/* Bar meter */}
                <div
                  style={{
                    height: '6px',
                    width: '100%',
                    backgroundColor: 'rgba(61,47,40,0.06)',
                    borderRadius: 'var(--radius-pill)',
                    overflow: 'hidden'
                  }}
                >
                  <div
                    style={{
                      height: '100%',
                      width: `${percent}%`,
                      backgroundColor: item.color,
                      borderRadius: 'var(--radius-pill)',
                      transition: 'width 400ms ease'
                    }}
                  />
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
